{
  "name": "hxh-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:implementation": "node scripts/audit-implementation.mjs",
    "audit:story": "node scripts/audit-story-architecture.mjs",
    "audit:reference": "node scripts/audit-reference-backbone.mjs",
    "audit:characters": "node scripts/audit-character-profiles.mjs",
    "audit:final": "node scripts/audit-final-polish.mjs",
    "audit:governance": "node scripts/audit-archive-governance.mjs",
    "audit:design-system": "node scripts/audit-design-system.mjs",
    "audit:schema": "node scripts/audit-data-schema.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:readability": "node scripts/run-css-aware-audit.mjs audit-readability.mjs",
    "audit:layout": "node scripts/run-css-aware-audit.mjs audit-layout.mjs",
    "audit:accessibility": "node scripts/run-css-aware-audit.mjs audit-accessibility.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:polish": "node scripts/run-css-aware-audit.mjs audit-polish.mjs",
    "audit:greed-island-archive": "node scripts/audit-greed-island-archive.mjs",
    "audit:greed-island-libraries": "node scripts/audit-greed-island-libraries.mjs",
    "audit:greed-island-systems": "node scripts/audit-greed-island-systems.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:accessibility": "node scripts/accessibility-qa.mjs",
    "qa:performance": "node scripts/audit-performance.mjs && node scripts/performance-qa.mjs",
    "stabilize:media": "node scripts/stabilize-media.mjs",
    "stabilize:rooms": "node scripts/stabilize-room-media.mjs",
    "stabilize:greed-island-cards": "node scripts/stabilize-greed-island-card-media.mjs",
    "audit:media": "node scripts/stabilize-media.mjs --verify-only && node scripts/stabilize-room-media.mjs --verify-only && node scripts/audit-media.mjs",
    "package:release": "node scripts/package-release.mjs",
    "audit:release": "node scripts/run-css-aware-audit.mjs audit-release.mjs",
    "audit:gaps": "node scripts/report-gaps.mjs",
    "preflight:build": "node scripts/run-build-preflight.mjs",
    "build": "npm run generate:build-info && npm run preflight:build && npm run package:release && npm run audit:release && node scripts/clean-hosting.mjs && vite build && npm run audit:performance && node scripts/prepare-hosting.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "browser:deps": "npm install --no-save --save-exact playwright@1.61.1 axe-core@4.12.1",
    "browser:install": "npx playwright install chromium",
    "qa:search": "node scripts/search-qa.mjs",
    "qa:interaction": "node scripts/interaction-qa.mjs",
    "qa:greed-island": "node scripts/audit-greed-island-archive.mjs && node scripts/audit-greed-island-libraries.mjs && node scripts/audit-greed-island-systems.mjs && node scripts/stabilize-greed-island-card-media.mjs --verify-only && node scripts/audit-greed-island-media.mjs && node scripts/greed-island-qa.mjs && node scripts/greed-island-archive-qa.mjs && node scripts/greed-island-libraries-qa.mjs && node scripts/greed-island-systems-qa.mjs",
    "qa:browser": "npm run build && npm run qa:search && npm run qa:visual && npm run qa:accessibility && npm run qa:interaction && npm run qa:greed-island && npm run qa:performance"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {},
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
