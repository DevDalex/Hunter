{
  "name": "hxh-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run prepare:media-derivatives",
    "dev": "vite --host 0.0.0.0",
    "design:lab": "npm run prepare:media-derivatives && vite --host 0.0.0.0 --open /__design-lab",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "audit:routes": "node scripts/audit-route-registry.mjs",
    "audit:coverage": "node scripts/audit-archive-coverage.mjs",
    "audit:spoilers": "node scripts/audit-chapter-boundary.mjs",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "audit:media-derivatives": "node scripts/generate-media-derivatives.mjs --verify-only",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:portraits": "node scripts/portrait-roster-audit.mjs",
    "qa:accessibility": "node scripts/accessibility-qa.mjs",
    "qa:search": "node scripts/search-qa.mjs",
    "qa:homepage": "node scripts/homepage-browser-qa.mjs",
    "qa:characters": "node scripts/characters-browser-qa.mjs",
    "stabilize:media": "node scripts/stabilize-media.mjs",
    "stabilize:rooms": "node scripts/stabilize-room-media.mjs",
    "prepare:media-derivatives": "node scripts/generate-media-derivatives.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "check": "npm run generate:build-info && npm run test:unit && npm run audit:routes && npm run audit:coverage && npm run audit:spoilers && npm run audit:accessibility && npm run audit:portraits && npm run audit:dependencies",
    "build:runtime": "node scripts/clean-hosting.mjs && npm run prepare:media-derivatives && npm run audit:media-derivatives && vite build && npm run audit:performance && node scripts/prepare-hosting.mjs && npm run audit:release",
    "build": "npm run build:runtime",
    "verify": "npm run check && npm run build:runtime",
    "doctor": "npm run verify",
    "deploy": "npm run verify && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "browser:install": "playwright install chromium",
    "qa:browser:ci": "npm run audit:portraits && npm run build && npm run qa:homepage && npm run qa:characters && npm run qa:accessibility && npm run qa:search"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@gsap/react": "2.1.2",
    "graphology": "0.26.0",
    "gsap": "3.15.0",
    "lucide-react": "1.24.0",
    "minisearch": "7.2.0",
    "motion": "13.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.12.1",
    "playwright": "1.61.1",
    "storybook": "10.5.10",
    "vite": "8.1.4",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
