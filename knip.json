{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.jsx",
    "server/index.js",
    "scripts/**/*.mjs",
    "tests/**/*.{js,jsx}",
    "vite.config.js",
    "vitest.config.js",
    "playwright.config.js"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "server/**/*.js",
    "scripts/**/*.mjs",
    "tests/**/*.{js,jsx}",
    "*.config.js"
  ],
  "ignore": [
    "dist/**",
    ".visual-qa/**",
    ".chimera-ant-qa/**",
    "playwright-report/**",
    "test-results/**",
    "public/hxh-archive-phase-*.zip"
  ],
  "ignoreDependencies": [
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "jsdom"
  ]
}
