{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunter-archive-sites",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-23",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
