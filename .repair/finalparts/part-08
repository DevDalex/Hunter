+.chapter-research-ledger { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; overflow: visible; }
+.chapter-research-ledger > button { min-width: 0; display: grid; align-content: start; gap: 6px; border: 1px solid var(--line); padding: 15px; background: var(--surface); text-align: left; cursor: pointer; }
+.chapter-research-ledger > button.is-selected { border-color: var(--forest); box-shadow: inset 4px 0 var(--forest); }
+.chapter-research-ledger > button span { color: var(--gold); font-size: 9px; text-transform: uppercase; }
+.chapter-research-ledger > button h3 { margin: 0; font-size: 18px; }
+.chapter-research-ledger > button p { font-size: 11px; }
+.chapter-research-ledger > button > div { display: flex; flex-wrap: wrap; gap: 4px; }
+.chapter-research-ledger > button small { border-radius: 99px; padding: 3px 6px; background: var(--paper-deep); }
