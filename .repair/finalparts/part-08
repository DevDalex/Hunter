+.record-visual-strip figure { overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
+.record-visual-strip img { width: 100%; aspect-ratio: 16/8; object-fit: cover; }
+.record-visual-strip figcaption { padding: 9px 12px; font-family: var(--serif); }
+.chapter-dossier__toolbar { grid-template-columns: minmax(240px,1fr) minmax(170px,.3fr) auto; align-items: center; }
+.chapter-record-inspector__meta { grid-template-columns: repeat(auto-fit,minmax(140px,1fr)); }
