+.nen-concept-visual { min-height: 150px; display: grid; place-items: center; align-content: center; gap: 7px; overflow: hidden; position: relative; margin: 0; background: radial-gradient(circle at 50% 45%, rgba(212,183,96,.28), transparent 25%), linear-gradient(145deg,#111914,#27372f); color: #fff; text-align: center; }
+.nen-concept-visual::before, .nen-concept-visual::after { content: ''; position: absolute; border: 2px solid rgba(212,183,96,.55); border-radius: 50%; }
+.nen-concept-visual::before { width: 88px; height: 88px; }
+.nen-concept-visual::after { width: 124px; height: 124px; opacity: .35; }
+.nen-concept-visual i { width: 16px; height: 16px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 28px var(--gold); z-index: 1; }
+.nen-concept-visual b, .nen-concept-visual small { z-index: 1; }
+.nen-concept-visual b { font-family: var(--serif); font-size: 18px; }
+.nen-concept-visual small { font-size: 9px; text-transform: uppercase; letter-spacing: .12em; }
+.power-bloc-visual { height: 180px; display: grid; place-items: center; align-content: center; gap: 7px; margin: 0 0 16px; position: relative; overflow: hidden; background: linear-gradient(150deg,#111914,#2e3b34); color: #fff; text-align: center; }
+.power-bloc-visual::before { content: ''; width: 110px; height: 76px; border: 3px solid var(--gold); transform: skew(-12deg); opacity: .7; }
+.power-bloc-visual i { position: absolute; width: 170px; height: 1px; background: rgba(212,183,96,.55); }
+.power-bloc-visual strong, .power-bloc-visual small { position: relative; }
+.power-bloc-visual small { color: var(--gold); font-size: 9px; text-transform: uppercase; }
+.record-visual { min-height: 155px; display: grid; place-items: center; align-content: end; position: relative; margin: 0; background: linear-gradient(145deg,#121a16,#33443b); color: #fff; }
+.record-visual i { position: absolute; inset: 22px 30px 48px; border: 2px solid rgba(212,183,96,.65); }
+.record-visual i::before, .record-visual i::after { content: ''; position: absolute; left: 18px; right: 18px; height: 2px; background: rgba(212,183,96,.5); }
+.record-visual i::before { top: 27px; } .record-visual i::after { top: 55px; }
+.record-visual figcaption { width: 100%; position: relative; background: rgba(0,0,0,.3); }
