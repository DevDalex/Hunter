{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hxh.archive.bibliographyRecord",
  "title": "Hunter x Hunter Archive Bibliography Record",
  "type": "object",
  "required": ["id", "title", "href", "category", "recordTypes", "usedBy", "status", "notes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 2 },
    "href": { "type": "string", "format": "uri" },
    "category": { "type": "string", "minLength": 2 },
    "recordTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "usedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "status": { "type": "string", "enum": ["approved", "review", "retired"] },
    "notes": { "type": "string", "minLength": 8 }
  }
}
