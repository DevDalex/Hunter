{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hxh.archive.chapterRecord",
  "title": "Hunter x Hunter Archive Chapter Record",
  "type": "object",
  "required": ["id", "chapter", "title", "arcId", "summary", "sourceIds", "evidenceState"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^chapter\\.[0-9]+$" },
    "chapter": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "volume": { "type": ["integer", "null"], "minimum": 1 },
    "arcId": { "type": "string", "pattern": "^arc\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summary": { "type": "string" },
    "characters": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "locations": { "type": "array", "items": { "type": "string" } },
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "evidenceState": { "type": "string" }
  }
}
