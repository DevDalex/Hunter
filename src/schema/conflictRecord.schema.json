{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hxh.archive.conflictRecord",
  "title": "Hunter x Hunter Archive Conflict Record",
  "type": "object",
  "required": ["id", "title", "conflictType", "participantIds", "arcId", "outcome", "sourceIds", "evidenceState"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^conflict\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 2 },
    "conflictType": { "type": "string" },
    "participantIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "arcId": { "type": "string", "pattern": "^arc\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "locationIds": { "type": "array", "items": { "type": "string" } },
    "turningPoint": { "type": "string" },
    "outcome": { "type": "string" },
    "consequence": { "type": "string" },
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "evidenceState": { "type": "string" }
  }
}
